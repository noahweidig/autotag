{
  "manifest_version": 2,
  "name": "Autotag",
  "version": "0.2.2",
  "description": "Automatically assign tags to papers using LLMs.",
  "homepage_url": "https://github.com/noahweidig/autotag",
  "author": "Chenkun (CJ) Jiang",
  "chrome": {
    "content": [
      {
        "id": "autotag",
        "path": "content/"
      }
    ]
  },
  "icons": {
    "48": "content/icons/autotag-48.png",
    "96": "content/icons/autotag.png"
  },
  "applications": {
    "zotero": {
      "id": "autotag@noahweidig",
      "strict_min_version": "6.999",
      "strict_max_version": "10.0.*"
    }
  }
}
